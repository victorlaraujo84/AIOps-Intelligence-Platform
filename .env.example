# GEMINI_API_KEY: Required for Gemini AI API calls (injected by AI Studio when applicable).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

# Segurança e Sessão (substituir em produção por segredo criptográfico de 32+ bytes)
AUTH_SESSION_SECRET="CHANGE_ME_GENERATE_64_HEX_SECRET"
CREDENTIAL_ENCRYPTION_KEY="CHANGE_ME_GENERATE_32_BYTE_KEY"
# Token aleatório de 32+ bytes para inicializar uma base vazia.
AIOPS_BOOTSTRAP_TOKEN=""
# IP ou CIDR do proxy TLS confiável. Deixe vazio sem um proxy confiável.
AIOPS_TRUST_PROXY=""
SQLITE_DB_PATH="./data/aiops.db"

# Docker Compose. Localhost usa certificado da CA interna do proxy.
AIOPS_HOST=localhost
AIOPS_BIND_IP=127.0.0.1
# Use IP e sub-rede compatíveis se a faixa padrão conflitar com o host.
# AIOPS_PROXY_SUBNET=172.31.250.0/24
# AIOPS_PROXY_IP=172.31.250.254

# PostgreSQL do perfil opcional core
POSTGRES_PASSWORD=""

# Configuração opcional para ferramentas Python executadas fora do Compose
DATABASE_URL="postgresql+asyncpg://aiops:CHANGE_ME_DB_PASS@postgres:5432/aiops_platform"
REDIS_URL="redis://redis:6379/0"
MLFLOW_TRACKING_URI="http://mlflow:5000"

# Autenticação PostgreSQL opcional, exclusiva do FastAPI interno.
AIOPS_POSTGRES_AUTH_DSN=""
AIOPS_POSTGRES_AUTH_SESSION_SECRET=""
AIOPS_POSTGRES_INVENTORY_DSN=""
AIOPS_POSTGRES_SITE_WRITE_DSN=""
AIOPS_POSTGRES_ASSET_WRITE_DSN=""
AIOPS_POSTGRES_SERVICE_WRITE_DSN=""

# Agente de IA Híbrido (opcional; padrão: offline)
AI_AGENT_MODE="offline"
OPENAI_API_KEY=""
OLLAMA_BASE_URL="http://localhost:11434"
