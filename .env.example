# GEMINI_API_KEY: Required for Gemini AI API calls (injected by AI Studio when applicable).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

# Segurança e Sessão (substituir em produção por segredo criptográfico de 32+ bytes)
AUTH_SESSION_SECRET="CHANGE_ME_GENERATE_64_HEX_SECRET"
CREDENTIAL_ENCRYPTION_KEY="CHANGE_ME_GENERATE_32_BYTE_KEY"
# Token aleatório de 32+ bytes para inicializar uma base vazia.
AIOPS_BOOTSTRAP_TOKEN=""
# IP ou CIDR do proxy TLS confiável. Deixe vazio sem um proxy confiável.
AIOPS_TRUST_PROXY=""
SQLITE_DB_PATH="./data/aiops.db"

# Stack Python / PostgreSQL / Redis (para execução via Docker Compose / FastAPI)
DATABASE_URL="postgresql+asyncpg://aiops:CHANGE_ME_DB_PASS@postgres:5432/aiops_platform"
REDIS_URL="redis://redis:6379/0"
MLFLOW_TRACKING_URI="http://mlflow:5000"

# Agente de IA Híbrido (opcional; padrão: offline)
AI_AGENT_MODE="offline"
OPENAI_API_KEY=""
OLLAMA_BASE_URL="http://localhost:11434"
