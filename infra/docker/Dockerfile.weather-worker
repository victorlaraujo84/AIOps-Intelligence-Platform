FROM node:22-alpine
WORKDIR /app/services/weather-worker
# The PostgreSQL workers share the pinned Node runtime dependencies.
COPY services/itsm-worker/package.json services/itsm-worker/package-lock.json ./
RUN npm ci --omit=dev --no-audit --no-fund
COPY services/weather-worker/worker.ts ./
COPY src/server/open-meteo-current.ts src/server/outbound-http.ts src/server/security.ts /app/src/server/
USER node
CMD ["node", "--import", "tsx", "worker.ts"]
