# GEMINI_API_KEY: Required for Gemini AI API calls (injected by AI Studio when applicable).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

# Segurança e Sessão (substituir em produção por segredo criptográfico de 32+ bytes)
AUTH_SESSION_SECRET=
CREDENTIAL_ENCRYPTION_KEY=
SQLITE_DB_PATH="./data/aiops.db"

# Stack Python / PostgreSQL / Redis (para execução via Docker Compose / FastAPI)
# Execute npm run docker:init para preencher os quatro segredos, sem sobrescrever .env.
COMPOSE_PROJECT_NAME=aiops-local
WEB_PORT=3000
API_PORT=8000
POSTGRES_DB=aiops_platform
POSTGRES_USER=aiops
POSTGRES_PASSWORD=
REDIS_PASSWORD=
# DATABASE_URL e REDIS_URL são compostos pelo Compose com os valores acima.
MLFLOW_TRACKING_URI="http://mlflow:5000"

# Agente de IA Híbrido (opcional; padrão: offline)
AI_AGENT_MODE="offline"
OPENAI_API_KEY=""
OLLAMA_BASE_URL="http://localhost:11434"
