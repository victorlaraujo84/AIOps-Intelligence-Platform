FROM node:22-alpine

WORKDIR /app

COPY package.json package-lock.json .npmrc ./
RUN npm ci --no-audit --no-fund

COPY . .
RUN npm run check:sqlite
RUN npm run build

RUN mkdir -p /app/data \
    && touch /app/data/.docker-volume \
    && chown -R node:node /app/data
USER node
EXPOSE 3000
CMD ["node", "--import", "tsx", "server.ts"]
